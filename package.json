{
  "name": "docpouch",
  "private": true,
  "version": "1.24.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build:frontend": "vite build",
    "build:backend": "tsc -p tsconfig.backend.json && node -e \"require('fs').cpSync('src/srv/oidc-login.html', 'dist/srv/oidc-login.html'); require('fs').cpSync('src/srv/oidc-logout.html', 'dist/srv/oidc-logout.html'); require('fs').cpSync('src/srv/assets/docPouch.png', 'dist/srv/docPouch.png')\"",
    "build": "npm run build:backend && npm run build:frontend",
    "run": "node ./dist/srv/main.js",
    "preview": "vite preview",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --detectOpenHandles",
    "test:http": "node --experimental-vm-modules node_modules/jest/bin/jest.js test/http --runInBand",
    "test:websocket": "node --experimental-vm-modules node_modules/jest/bin/jest.js test/websocket --runInBand",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch --runInBand"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BFH-JTF/doc-pouch"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@seald-io/nedb": "^4.1.2",
    "@types/nodemailer": "^8.0.1",
    "adm-zip": "^0.6.0",
    "archiver": "^8.0.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "docpouch-client": "^1.2.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "jsonwebtoken": "9.0.3",
    "multer": "2.2.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^9.0.3",
    "oidc-provider": "^9.9.1",
    "semver": "^7.8.5",
    "socket.io": "^4.8.3",
    "vue": "^3.5.40",
    "vuetify": "^4.1.5",
    "winston": "^3.19.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-typescript": "^8.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/adm-zip": "^0.5.8",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-ws": "^3.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/oidc-provider": "^9.5.0",
    "@types/semver": "^7.7.1",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "babel-jest": "^30.4.1",
    "jest": "^30.4.2",
    "semantic-release": "^25.0.7",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vue-tsc": "^3.3.7"
  },
  "overrides": {
    "@babel/core": "$@babel/core"
  }
}
