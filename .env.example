# DocPouch Environment Configuration
# Copy this file to .env and adjust the values

# Server
PORT=3030
ALLOWED_ORIGINS=*
ALLOWED_HEADERS='Content-Type, Authorization'
MEMORY_ONLY=false
PREFIX=docpouch_

#JWT Setting
JWT_SECRET=your-secure-jwt-secret-here

# OIDC Provider
OIDC_ISSUER=http://localhost:3030
OIDC_REGISTRATION_TOKEN=VRZue27SL8LN8yP6S3NIwUHa4CcxtaO7RTFAD02zh18
OIDC_COOKIE_KEY=docpouch-cookie-secret-change-in-production

# Logging (debug, info, warn, error)
LOG_LEVEL=info

# Node Environment
NODE_ENV=development
