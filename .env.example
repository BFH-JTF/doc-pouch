# DocPouch Environment Configuration
# Copy this file to .env and adjust the values

# Server
PORT=3030
ALLOWED_ORIGINS=*
# Comma-separated list of request headers allowed in CORS preflight.
# Leave empty (or unset) to mirror the browser's
# Access-Control-Request-Headers — required for clients that send
# additional headers such as docpouch-client's X-Socket-ID.
# ALLOWED_HEADERS=
MEMORY_ONLY=false
PREFIX=docpouch_

# JWT Settings
JWT_SECRET=your-secure-jwt-secret-here

# Session timeout for both JWT tokens and OIDC sessions.
# Accepts a duration string: e.g. "24h", "8h", "30m", "7d".
# Default: "24h"
SESSION_TIMEOUT=24h

# OIDC Provider
OIDC_ISSUER=http://localhost:3030
OIDC_REGISTRATION_TOKEN=VRZue27SL8LN8yP6S3NIwUHa4CcxtaO7RTFAD02zh18
OIDC_COOKIE_KEY=docpouch-cookie-secret-change-in-production
# Set to 'true' when running the server directly with HTTPS (no reverse proxy).
# Leave unset (or false) when behind a TLS-terminating reverse proxy like nginx or Caddy.
OIDC_COOKIE_SECURE=false

# Logging (debug, info, warn, error)
LOG_LEVEL=info

# Allow creation of anonymous documents via POST /docs/create {anonymous:true}.
# When false (default), such requests are rejected with HTTP 400.
# When true, application logs are reduced for document creation operations
# and the OIDC session store is switched to an in-memory adapter to prevent
# de-anonymization via the session database. Existing data is not modified.
# WARNING: do not set LOG_LEVEL=debug while this flag is enabled, as the
# debug-level redaction is not absolute.
ANONYMOUS_DOCUMENTS_ENABLED=false

# Node Environment
NODE_ENV=development
