# DocPouch Environment Configuration
# Copy this file to .env and adjust the values

# Server
PORT=3030
ALLOWED_ORIGINS=*
# Comma-separated list of request headers allowed in CORS preflight.
# Leave empty (or unset) to mirror the browser's
# Access-Control-Request-Headers — required for clients that send
# additional headers such as docpouch-client's X-Socket-ID.
# ALLOWED_HEADERS=
MEMORY_ONLY=false
PREFIX=docpouch_

# JWT Settings
JWT_SECRET=your-secure-jwt-secret-here

# Session timeout for both JWT tokens and OIDC sessions.
# Accepts a duration string: e.g. "24h", "8h", "30m", "7d".
# Default: "24h"
SESSION_TIMEOUT=24h

# OIDC Provider
OIDC_ISSUER=http://localhost:3030
# Bearer token required for dynamic client registration (POST /oidc/reg).
# When unset (or blank), dynamic client registration is disabled entirely.
# Generate a strong value, e.g.: openssl rand -base64 32
OIDC_REGISTRATION_TOKEN=change-me-generate-a-random-token
# Redirect URI of the built-in admin UI client. Leave unset to use the
# issuer origin. Only set this when the SPA is served from a different
# origin than the OIDC issuer.
# OIDC_REDIRECT_URI=http://localhost:3030/
# Clients whose consent is granted silently (comma-separated client IDs).
# First-party applications only. Every other client must be approved by
# the signed-in user on the consent screen.
# OIDC_AUTO_CONSENT_CLIENTS=docpouch-admin-ui
OIDC_COOKIE_KEY=docpouch-cookie-secret-change-in-production
# Set to 'true' when running the server directly with HTTPS (no reverse proxy).
# Leave unset (or false) when behind a TLS-terminating reverse proxy like nginx or Caddy.
OIDC_COOKIE_SECURE=false

# Logging (debug, info, warn, error)
LOG_LEVEL=info

# Allow creation of anonymous documents via POST /docs/create {anonymous:true}.
# When false (default), such requests are rejected with HTTP 400.
# When true, application logs are reduced for document creation operations
# and the OIDC session store is switched to an in-memory adapter to prevent
# de-anonymization via the session database. Existing data is not modified.
# WARNING: do not set LOG_LEVEL=debug while this flag is enabled, as the
# debug-level redaction is not absolute.
ANONYMOUS_DOCUMENTS_ENABLED=false

# Rate Limiting
# Global override: when set, applies to ALL rate limiters (api, write, auth,
# authIp, forgot-password, reset-password). When unset, each limiter uses its
# built-in default (e.g. 100 for general API, 30 for write operations, 5 for
# auth, 30 for the IP-wide auth cap).
# The auth limiter keys clients by IP + username, so users behind a NAT router
# do not lock each other out.
# RATE_LIMIT_MAX=100
# Duration string: e.g. "15m", "1h", "30s", "2d".
# RATE_LIMIT_WINDOW=15m

# Trusted Proxy
# Controls which proxy hops of X-Forwarded-* headers are trusted when
# resolving the client IP. Accepted: loopback, linklocal, uniquelocal, a hop
# count (e.g. 1), true, false, or a comma-separated list of IP addresses /
# CIDR subnets (e.g. 10.1.2.3, 192.168.0.0/16). Default: loopback
# Set e.g. TRUST_PROXY=uniquelocal when the reverse proxy runs in Docker or
# on a remote host whose address is not a loopback address.
# Forwarded headers from peers not matching this setting are removed before
# request handling (they cannot influence IP resolution or the OIDC provider).
# TRUST_PROXY=loopback

# MCP (Model Context Protocol) Server
# Mount the MCP server at /mcp for AI agent integration.
# Set to 'false' to disable. Default: true (enabled).
# MCP_ENABLED=true

# SMTP (Email) Settings
# If SMTP_HOST is empty or unset, email delivery is disabled and
# passwords are returned in API responses as a fallback.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM must be a real, deliverable address on a domain that exists in
# DNS and whose SPF/DKIM records authorize this SMTP server to send for it;
# mail from placeholder domains is accepted here but junked/dropped by
# strict receiving gateways.
# SMTP_FROM="DocPouch <noreply@example.com>"

# Node Environment
NODE_ENV=development
